<%=render Templates::ListTemplateComponent.new(
    breadcrumb: [
        {label: "Users", path: users_path}, 
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)},
        {label: "Projects", path: user_projects_path(@user)}, 
        {label: "#{@project.name}", path: user_project_path(@user, @project)},
        {label: "Sites", path: user_project_sites_path(@user, @project)},
        {label: "#{@site.name}", path: user_project_site_path(@user, @project, @site)},
        {label: "Excavation Units"}
    ],
    header: {
        items: @user,
        actions: [
            {
                label: "New Excavation Unit",
                path: new_user_project_site_excavation_unit_path(@user, @project, @site),
                variant: :primary
            }
        ]
    },
    table: {
        items: @excavation_units, 
        pagy: @pagy, 
        columns: [
            {label: "ID", accessor: :id},
            {label: "Name", accessor: :name},
        ],
        actions: [
            {label: "View", path_proc: ->(excavation_unit) {user_project_site_excavation_unit_path(excavation_unit.site.project.user_id, excavation_unit.site.project_id, excavation_unit.site_id, excavation_unit)}},
            {label: "Edit", path_proc: ->(excavation_unit) {edit_user_project_site_excavation_unit_path(excavation_unit.site.project.user_id, excavation_unit.site.project_id, excavation_unit.site_id, excavation_unit)}},
            {
                label: "Delete",
                path_proc: ->(excavation_unit) {user_project_site_excavation_unit_path(excavation_unit.site.project.user_id, excavation_unit.site.project_id, excavation_unit.site_id, excavation_unit)},
                variant: :link_danger,
                data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
            }
        ]
    }
)%>
