<%= render Templates::ListTemplateComponent.new(
    breadcrumb: [
        {label: "Users", path: users_path}, 
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)}, 
        {label: "Projects", path: user_projects_path(@user)}
    ], 
    header: {
        items: @user,
        actions: [
            {label: "Create Project", path: new_user_project_path(@user), variant: :primary}
        ]
    }, 
    table: {
        items: @projects, 
        pagy: @pagy, 
        columns: [
            {label: "ID", accessor: :id}, 
            {label: "Name", accessor: :name}, 
            {label: "Status", accessor: :status}
        ], 
        actions: [
            {label: "View", path_proc: ->(project) {user_project_path(project.user_id, project)}}
        ]
    }
)%>
