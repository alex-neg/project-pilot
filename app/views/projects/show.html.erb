<%=render Templates::DetailTemplateComponent.new(
    title: @project.name,
    breadcrumb: [
        {label: "Users", path: users_path}, 
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)},
        {label: "Projects", path: user_projects_path(@project.user)}, 
        {label: @project.name, path: user_project_path(@project.user, @project)}
    ], 
    attributes: [
        {
            label: "ID", 
            value: @project.id
        },
        {
            label: "Name", 
            value: @project.name
        }, 
        {
            label: "Status", 
            value: @project.status
        }, 
        {
            label: "Sites", 
            path: user_project_sites_path(@user, @project), 
            variant: :link,
            count: @project.sites.count
        }
    ], 
    actions: [
        {
            label: "Edit",
            path: edit_user_project_path(@user, @project)
        }, 
        {
            label: "Delete",
            path: user_project_path(@user, @project),
            variant: :danger,
            data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
        }
    ]

)%>
