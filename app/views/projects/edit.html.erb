<%= render Templates::FormTemplateComponent.new(
    breadcrumb: [
        {label: "Projects", path: projects_path},
        {label: "Edit"}
    ], 
    header: {
        title: "Edit Project"
    }, 
    form: {
        record: @project,
        url: project_path(@project),
        method: :patch,
        submit_label: "Update",
        inputs: [
            {
                label: "Name", 
                accessor: :name
            }, 
            {
                label: "Status", 
                accessor: :status,
                collection: Project.statuses.keys.map { |status| [status.titleize, status] }
            }
        ]
    }
)%>
