<%=render Templates::DetailTemplateComponent.new(
    title: "#{@user.first_name} #{@user.last_name}",
    breadcrumb: [
        {label: "Users", path: users_path},
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)}
    ],
    attributes: [
        {label: "ID", value: @user.id},
        {label: "First Name", value: @user.first_name},
        {label: "Last Name", value: @user.last_name},
        {label: "Email", value: @user.email},
        {
            label: "Projects",
            path: projects_path,
            variant: :link,
            count: @user.projects.count
        },
    ],
    actions: [
        {label: "Edit", path: edit_user_path(@user)},
        {
            label: "Delete",
            path: user_path(@user),
            variant: :danger,
            data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
        }
    ]
)%>