<%=render Templates::FormTemplateComponent.new(
    breadcrumb: [
        {label: "Projects", path: projects_path}, 
        {label: "#{@project.name}", path: project_path(@project)},
        {label: "Sites", path: project_sites_path(@project)}, 
        {label: "Edit"}
    ], 
    header: {
        title: "Edit Site"
    }, 
    form: {
        record: @site,
        url: project_site_path(@project, @site),
        method: :patch,
        submit_label: "Update",
        inputs: [
            {
                label: "Name", 
                accessor: :name
            }, 
            {
                label: "Status", 
                accessor: :status,
                collection: Site.statuses.keys.map { |status| [status.titleize, status] }
            }
        ]
    }
)%>
