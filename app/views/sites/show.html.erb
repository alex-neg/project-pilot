<%=render Templates::DetailTemplateComponent.new(
    title: @site.name, 
    breadcrumb: [
        {label: "Projects", path: projects_path}, 
        {label: "#{@project.name}", path: project_path(@project)},
        {label: "Sites", path: project_sites_path(@project)}, 
        {label: "#{@site.name}"}
    ],
    attributes: [
        {
            label: "ID",
            value: @site.id
        }, 
        {
            label: "Name",
            value: @site.name
        },
        {
            label: "Status",
            value: @site.status
        },
        {
            label: "Excavation Units",
            path: project_site_excavation_units_path(@project, @site),
            variant: :link,
            count: @site.excavation_units.count
        }
    ],
    actions: [
        {
            label: "Edit",
            path: edit_project_site_path(@project, @site)
        }, 
        {
            label: "Delete",
            path: project_site_path(@project, @site),
            variant: :danger,
            data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
        }
    ]
)%>
