<%=render Templates::DetailTemplateComponent.new(
    title: @site.name, 
    breadcrumb: [
        {label: "Users", path: users_path}, 
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)},
        {label: "Projects", path: user_projects_path(@user)}, 
        {label: "#{@project.name}", path: user_project_path(@user, @project)},
        {label: "Sites", path: user_project_sites_path(@user, @project)}, 
        {label: "#{@site.name}"}
    ],
    attributes: [
        {
            label: "ID",
            value: @site.id
        }, 
        {
            label: "Name",
            value: @site.name
        },
        {
            label: "Status",
            value: @site.status
        },
        {
            label: "Excavation Units",
            path: user_project_site_excavation_units_path(@user, @project, @site),
            variant: :link,
            count: @site.excavation_units.count
        }
    ],
    actions: [
        {
            label: "Edit",
            path: edit_user_project_site_path(@user, @project, @site)
        }, 
        {
            label: "Delete",
            path: user_project_site_path(@user, @project, @site),
            variant: :danger,
            data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
        }
    ]
)%>
