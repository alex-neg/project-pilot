<%=render Templates::FormTemplateComponent.new(
    breadcrumb: [
        {label: "Users", path: users_path}, 
        {label: "#{@user.first_name} #{@user.last_name}", path: user_path(@user)},
        {label: "Projects", path: user_projects_path(@user)}, 
        {label: "#{@project.name}", path: user_project_path(@user, @project)},
        {label: "Sites", path: user_project_sites_path(@user, @project)}, 
        {label: "New"}
    ], 
    header: {
        title: "New Site"
    }, 
    form: {
        record: @site,
        url: user_project_sites_path(@user, @project),
        submit_label: "Create",
        inputs: [
            {
                label: "Name", 
                accessor: :name
            }, 
            {
                label: "Status", 
                accessor: :status,
                collection: Site.statuses.keys.map { |status| [status.titleize, status] }
            }
        ]
    }
)%>